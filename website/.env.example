# Copy to .env.local for local dev.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# Both values are public-by-design: the anon key is safe in the client bundle
# because Supabase RLS enforces access at the DB layer.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
