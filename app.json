{
  "expo": {
    "name": "Hey Otis",
    "slug": "tether",
    "owner": "samahhee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f5fd"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.heyotis.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#f7f5fd"
      },
      "package": "com.heyotis.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-speech-recognition",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "tether",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce93e4cc-ff6d-4f96-bfa4-c0e0bfb84524"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ce93e4cc-ff6d-4f96-bfa4-c0e0bfb84524"
    }
  }
}
